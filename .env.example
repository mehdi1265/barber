# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# App
VITE_APP_NAME=Barber App
VITE_APP_VERSION=1.0.0

# Optional email-link targets (HTTPS only; see docs/22-email-confirmation.md).
# Leave unset to use the native scheme barberapp://confirm-email /
# barberapp://reset-password, or <origin>/confirm-email on web.
# VITE_CONFIRM_EMAIL_REDIRECT_URL=https://your-domain.example/confirm-email
# VITE_RECOVERY_REDIRECT_URL=https://your-domain.example/reset-password
