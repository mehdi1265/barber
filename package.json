{
  "name": "barber-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-sql-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-sql-wasm.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/**/*.{ts,tsx,css}",
    "format:check": "prettier --check src/**/*.{ts,tsx,css}",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "cap:build": "npm run build && npx cap sync && npm run native:deep-links",
    "cap:android": "npm run cap:build && npx cap open android",
    "cap:ios": "npm run cap:build && npx cap open ios",
    "android:release-config": "node scripts/android-release.ts",
    "native:deep-links": "node scripts/native-deep-links.ts",
    "rls:check": "node scripts/rls-check.ts",
    "type-check": "tsc -b"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor-community/sqlite": "7.0.3",
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.0.1",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.2.0",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/haptics": "^7.0.1",
    "@capacitor/ios": "^7.6.10",
    "@capacitor/keyboard": "^7.0.1",
    "@capacitor/local-notifications": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "@hookform/resolvers": "^7.0.6",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.62.7",
    "date-fns": "^4.1.0",
    "date-fns-jalali": "^4.1.0-0",
    "jeep-sqlite": "^2.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "sql.js": "1.11.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
